# Local test settings for the K Hotel staff key platform. Copy to .env (start.ps1 does this for you).
# Change a port here if another app on your PC already uses it; nothing else needs to change.

# Prefix for every container, volume, network and image of this project.
COMPOSE_PROJECT_NAME=khb-staffkey

# Host ports (chosen to avoid common ones such as 80, 443, 3000, 5000, 5432, 8000, 8080, 8443).
SMK_PORTAL_PORT=14080
SMK_SIM_PORT=14444
SMK_CONNECTOR_PORT=14090
SMK_EXPO_PORT=14081
# Simulated Visionline Web API, for a connector installed on this PC (always this-PC-only).
SMK_VL_PORT=14443

# Which connector talks to the simulator: "docker" (built in) or "native" (the Windows service you install).
# start.ps1 -NativeConnector / -DockerConnector switches it.
SMK_CONNECTOR=docker

# 127.0.0.1 = only this PC can open the portal (recommended).
# 0.0.0.0   = your phone on the same Wi-Fi can reach it (needed to test the staff app on a phone).
SMK_BIND=127.0.0.1

# "no" = containers start only when you run start.ps1. Use "unless-stopped" to start with Docker Desktop.
SMK_RESTART=no

HOTEL_TIMEZONE=Africa/Douala

# Development secrets. Replace for anything beyond your own PC.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
CALLBACK_SECRET=dev-callback-secret
